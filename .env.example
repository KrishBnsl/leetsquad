# Copy to .env for local use. Never commit the real .env.

# --- Local mode (default): nothing is required. Data lives in ./data ---
# PORT=3000
# TZ_NAME=Asia/Kolkata            # day boundary for "today" (default UTC)
# CLIST_USERNAME=you              # optional: LeetCode/Codeforces problem ratings from clist.by
# CLIST_API_KEY=...
# GITHUB_TOKEN=...                # optional: raises GitHub's API rate limit

# --- Hosted mode (Vercel + GitHub Actions): set these as Vercel env vars AND GitHub Actions secrets ---
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=...
# SECRET_KEY_HEX=<64 hex chars: the contents of data/secret.key>   # encrypts stored LeetCode cookies

# --- Optional: make "Refresh"/sign-up trigger the sync worker immediately (Vercel env only) ---
# GH_REPO=yourname/leetsquad
# GH_DISPATCH_TOKEN=...           # fine-grained token: this repo, Actions = read & write
